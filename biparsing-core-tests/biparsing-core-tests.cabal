cabal-version: 2.2
name: biparsing-core-test
version: 0.0.0.1
synopsis: tests for biparsing-core
category: Parsing
homepage: https://github.com/BebeSparkelSparkel/biparsing
author: William Rusnack
maintainer: William Rusnack
license: BSD-3-Clause
license-file: LICENSE
build-type: Simple

flag small
  description: Run a small subset of the transformer types.
  default: False

test-suite spec
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  -- cabal-gild: discover tests --exclude=tests/Spec.hs
  other-modules:
    Biparse.Core.ClassesSpec

  hs-source-dirs:
    tests/

  default-extensions:
    BlockArguments
    ConstraintKinds
    DataKinds
    DeriveGeneric
    FlexibleContexts
    FlexibleInstances
    ImportQualifiedPost
    LambdaCase
    MultiParamTypeClasses
    NamedFieldPuns
    ScopedTypeVariables
    TypeApplications
    TypeFamilies

  if flag(small)
    cpp-options:
      -DSMALL
  else
    ghc-options:
      -freduction-depth=100000

  ghc-options:
    -Werror
    -Weverything
    -Wno-implicit-prelude
    -Wno-incomplete-uni-patterns
    -Wno-missing-deriving-strategies
    -Wno-missing-export-lists
    -Wno-missing-import-lists
    -Wno-missing-kind-signatures
    -Wno-missing-local-signatures
    -Wno-missing-safe-haskell-mode
    -Wno-orphans
    -Wno-safe
    -Wno-unsafe
    -Wno-unused-packages

  build-tool-depends:
    hspec-discover:hspec-discover

  build-depends:
    base,
    biparsing-core,
    biparsing-test,
    biparsing-text,
    hspec,
    mono-traversable,

  mixins:
    base hiding (Prelude)

  default-language: Haskell2010
