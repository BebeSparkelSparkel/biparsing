cabal-version: 2.2
name: biparsing-mixes
version: 0.0.0.1
synopsis: Easy to use monad and type mixes for biparsing.
category: Parsing
homepage: https://github.com/BebeSparkelSparkel/biparsing
author: William Rusnack
maintainer: William Rusnack
license: BSD-3-Clause
license-file: LICENSE
build-type: Simple

flag padantic
  description: -Werror -Weverything
  default: False

library
  -- cabal-gild: discover src --exclude=src/Prelude.hs
  exposed-modules:
    Biparse.AssociatedWriter
    Biparse.Mixes.Either
    Biparse.Mixes.Exports
    Biparse.Mixes.SubStates

  other-modules:
    Prelude

  hs-source-dirs:
    src/

  default-extensions:
    AllowAmbiguousTypes
    BlockArguments
    DataKinds
    FlexibleContexts
    FlexibleInstances
    ImportQualifiedPost
    MultiParamTypeClasses
    PatternSynonyms
    RankNTypes
    ScopedTypeVariables
    StandaloneKindSignatures
    TypeApplications
    TypeFamilies
    UndecidableInstances

  if flag(padantic)
    ghc-options:
      -Werror
      -Weverything
      -Wno-implicit-prelude
      -Wno-missing-deriving-strategies
      -Wno-missing-kind-signatures
      -Wno-missing-local-signatures
      -Wno-missing-safe-haskell-mode
      -Wno-safe
      -Wno-unsafe
      -Wno-unused-packages
  build-depends:
    base,
    biparsing-combinators,
    biparsing-control,
    biparsing-core,
    biparsing-state,
    biparsing-text,
    bytestring,
    data-default,
    extra,
    microlens,
    mtl,
    text >=2.1.1,
    transformers >=0.6.1.1,

  mixins:
    base hiding (Prelude)

  default-language: Haskell2010

test-suite spec
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  -- cabal-gild: discover tests --exclude=tests/Spec.hs
  other-modules:
    Biparse.MixesSpec
    Prelude

  hs-source-dirs:
    tests/

  default-extensions:
    BlockArguments
    ImportQualifiedPost
    OverloadedStrings
    TupleSections
    TypeApplications

  if flag(padantic)
    ghc-options:
      -Werror
      -Weverything
      -fprint-potential-instances
      -Wno-implicit-prelude
      -Wno-incomplete-uni-patterns
      -Wno-missing-deriving-strategies
      -Wno-missing-export-lists
      -Wno-missing-import-lists
      -Wno-missing-kind-signatures
      -Wno-missing-local-signatures
      -Wno-missing-safe-haskell-mode
      -Wno-orphans
      -Wno-safe
      -Wno-unsafe
      -Wno-unused-packages
  build-tool-depends:
    hspec-discover:hspec-discover

  build-depends:
    biparsing-mixes,
    biparsing-test,
    data-default,
    hspec,
    template-haskell,

  mixins:
    biparsing-test (Prelude as Test.Prelude)

  default-language: Haskell2010
