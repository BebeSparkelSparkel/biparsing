{-# LANGUAGE TemplateHaskell #-}
{-# LANGUAGE UndecidableInstances #-}
module Biparse.State.Index (
IndexPosition(IndexPosition),
dataId,
index,
) where

import Biparse.State.Lenses (HasDataId(dataId))

data IndexPosition dataId = IndexPosition
  { _dataId :: dataId -- | typically () or FilePath
  , _index :: Int
  } deriving (Show, Eq)
instance HasDataId IndexPosition where dataId = lens _dataId \x y -> x {_dataId = y}
$(makeLensesFor [("_index","index")] ''IndexPosition)

instance Default dataId => Default (IndexPosition dataId) where def = IndexPosition def 0

instance MonoFoldable text => UpdateStateWithSubString (IndexPosition d) text where
  updateStateWithSubString x = index +~ length x

instance UpdateStateWithElement (IndexPosition d) a where
  updateStateWithElement _ = index %~ succ

instance Integral a => UpdateStateWithIndex (IndexPosition d) a where
  updateStateWithIndex x = index +~ fromIntegral x

